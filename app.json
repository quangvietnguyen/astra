{
  "expo": {
    "name": "Astra",
    "slug": "astra",
    "scheme": "astra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nqv.astra",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "NSLocationWhenInUseUsageDescription": "Astra uses your location to compute accurate topocentric Moon phase, orientation, and astronomical solar lighting for your sky."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071430"
      },
      "package": "com.nqv.astra",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIosSceneDelegate",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#071430",
          "enableFullScreenImage_legacy": true,
          "imageWidth": 288,
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#071430",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#071430",
            "imageWidth": 288
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Astra uses your location to compute accurate topocentric Moon phase, orientation, and astronomical solar lighting for your sky."
        }
      ],
      [
        "expo-dynamic-app-icon",
        {
          "new_moon": {
            "image": "./assets/icons/new_moon.png",
            "prerendered": true
          },
          "waxing_crescent": {
            "image": "./assets/icons/waxing_crescent.png",
            "prerendered": true
          },
          "first_quarter": {
            "image": "./assets/icons/first_quarter.png",
            "prerendered": true
          },
          "waxing_gibbous": {
            "image": "./assets/icons/waxing_gibbous.png",
            "prerendered": true
          },
          "full_moon": {
            "image": "./assets/icons/full_moon.png",
            "prerendered": true
          },
          "waning_gibbous": {
            "image": "./assets/icons/waning_gibbous.png",
            "prerendered": true
          },
          "last_quarter": {
            "image": "./assets/icons/last_quarter.png",
            "prerendered": true
          },
          "waning_crescent": {
            "image": "./assets/icons/waning_crescent.png",
            "prerendered": true
          }
        }
      ]
    ],
    "owner": "nqv",
    "extra": {
      "eas": {
        "projectId": "93993c7c-52d6-4d25-adb6-c5f8ef67f2c5"
      }
    }
  }
}
