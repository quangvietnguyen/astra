{
  "name": "astra",
  "version": "1.0.1",
  "packageManager": "pnpm@10.14.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:build:ios:dev": "eas build --platform ios --profile development",
    "eas:build:ios:preview": "eas build --platform ios --profile preview",
    "eas:build:ios:prod": "eas build --platform ios --profile production",
    "eas:build:ios:prod:nocache": "eas build --platform ios --profile production --clear-cache",
    "eas:build:ios:prod:submit": "eas build --platform ios --profile production --auto-submit",
    "eas:build:ios:prod:submit:nocache": "eas build --platform ios --profile production --auto-submit --clear-cache",
    "eas:build:android:preview": "eas build --platform android --profile preview",
    "eas:build:android:prod": "eas build --platform android --profile production",
    "eas:build:all:prod": "eas build --platform all --profile production",
    "eas:build:local:ios": "mkdir -p builds && EXPO_NO_KEYCHAIN=1 eas build --platform ios --profile production --local --output=./builds/astra.ipa",
    "eas:build:local:ios:submit": "pnpm run eas:build:local:ios && pnpm run transporter:upload:ios",
    "transporter:upload:ios": "bash scripts/upload-to-transporter.sh ./builds/astra.ipa",
    "transporter:open": "bash scripts/upload-to-transporter.sh ./builds/astra.ipa",
    "eas:build:local:android": "mkdir -p builds && eas build --platform android --profile production --local --output=./builds/astra.aab",
    "eas:credentials:setup": "bash scripts/setup-credentials.sh",
    "eas:credentials:ios": "eas credentials -p ios",
    "eas:credentials:android": "eas credentials -p android",
    "eas:submit:ios": "eas submit --platform ios",
    "eas:submit:ios:latest": "eas submit --platform ios --latest",
    "eas:submit:android": "eas submit --platform android",
    "eas:submit:android:latest": "eas submit --platform android --latest"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.2",
    "expo": "^58.0.22",
    "expo-asset": "~58.0.19",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-dynamic-app-icon": "^1.2.0",
    "expo-file-system": "~58.0.13",
    "expo-gl": "^58.0.4",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "^58.0.4",
    "expo-three": "^8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "eas-cli": "^23.2.0"
  },
  "private": true
}
